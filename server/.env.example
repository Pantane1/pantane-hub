# Backend environment variables (Render)
# Copy to server/.env for local development. Never commit real values.

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Required for Git-backed Journal and Sharp admin panels
GITHUB_TOKEN=your_github_personal_access_token
ADMIN_PASSWORD=your_admin_password

# Required for M-Pesa STK push and webhook verification
LIPANA_SECRET_KEY=your_lipana_secret_key
LIPANA_WEBHOOK_SECRET=your_lipana_webhook_secret

# Required for PH-Bot. Server-side only. Never use a VITE_ prefix.
GEMINI_API_KEY=your_gemini_api_key