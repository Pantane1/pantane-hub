# Frontend environment variables (Vite)
# Copy to .env for local development. Never commit real values.

VITE_API_URL=http://localhost:3000
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_notify_template_id
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_emailjs_autoreply_template_id

# Do not add Gemini or any other server-side secret here.
# GEMINI_API_KEY belongs only in the backend environment.